<?xml version="1.0" encoding="utf-8"?>
<!-- Круглая кнопка «старт» виджета: сигнальный жёлтый круг и тёмный треугольник по центру. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_start" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_widget_play"
        android:gravity="center" />
</layer-list>
