<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка «стоп» на пихтовом виджете «Месяц»: круг цвета бланка и графитовый квадратик. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_hero_stop" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_widget_stop_hero"
        android:gravity="center" />
</layer-list>
